POSTGRES_PASSWORD=change-me
RCON_PASSWORD=change-me
# Linux release archives matching the current CS2 build (see README "Worker image").
METAMOD_URL=
CSS_URL=
# Shared CS2 install (~60 GB), downloaded once by the cs2-install service.
CS2_BASE_DIR=./cs2-base
# Podman API socket, used by the orchestrator to restart hung workers.
DOCKER_SOCK=/run/user/1000/podman/podman.sock
API_PORT=8080
UI_PORT=8081
PUBLIC_API_URL=http://localhost:8080
